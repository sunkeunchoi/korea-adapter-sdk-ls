{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/RepositoryPath"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Digest"
        }
      },
      "required": [
        "schema_version",
        "path",
        "sha256",
        "media_type"
      ],
      "type": "object"
    },
    "AuditSuccessPayload": {
      "additionalProperties": false,
      "properties": {
        "record": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "row_id": {
          "$ref": "#/$defs/StableId"
        },
        "verdict": {
          "$ref": "#/$defs/AuditVerdict"
        }
      },
      "required": [
        "row_id",
        "verdict",
        "record"
      ],
      "type": "object"
    },
    "AuditVerdict": {
      "enum": [
        "confirmed",
        "refuted",
        "unverifiable"
      ],
      "type": "string"
    },
    "RepositoryPath": {
      "pattern": "^[A-Za-z0-9._/-]{1,1024}$",
      "type": "string"
    },
    "SchemaVersion": {
      "enum": [
        "v0"
      ],
      "type": "string"
    },
    "Sha256Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    }
  },
  "$id": "urn:ls:repository-engineering:schema:v0:worker-result",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "assignment_id": {
          "$ref": "#/$defs/StableId"
        },
        "attempt_id": {
          "$ref": "#/$defs/StableId"
        },
        "invocation_id": {
          "$ref": "#/$defs/StableId"
        },
        "payload": {
          "$ref": "#/$defs/AuditSuccessPayload"
        },
        "result": {
          "const": "succeeded",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "worker_instance_id": {
          "$ref": "#/$defs/StableId"
        },
        "worker_instance_receipt": {
          "$ref": "#/$defs/ArtifactReference"
        }
      },
      "required": [
        "result",
        "schema_version",
        "attempt_id",
        "invocation_id",
        "assignment_id",
        "worker_instance_id",
        "worker_instance_receipt",
        "payload"
      ],
      "type": "object"
    },
    {
