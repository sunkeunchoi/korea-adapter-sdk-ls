        "assignment_id": {
          "$ref": "#/$defs/StableId"
        },
        "attempt_id": {
          "$ref": "#/$defs/StableId"
        },
        "invocation_id": {
          "$ref": "#/$defs/StableId"
        },
        "reason": {
          "$ref": "#/$defs/StableId"
        },
        "result": {
          "const": "held",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "worker_instance_id": {
          "$ref": "#/$defs/StableId"
