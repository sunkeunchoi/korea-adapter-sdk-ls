{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/RepositoryPath"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Digest"
        }
      },
      "required": [
        "schema_version",
        "path",
        "sha256",
        "media_type"
      ],
      "type": "object"
    },
    "ArtifactSetReference": {
      "additionalProperties": false,
      "properties": {
        "aggregate_digest": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "artifact_set_id": {
          "$ref": "#/$defs/StableId"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/RepositoryPath"
          },
          "type": "array"
        },
        "validation_basis": {
          "$ref": "#/$defs/ArtifactReference"
        }
      },
      "required": [
        "artifact_set_id",
        "members",
        "aggregate_digest",
        "validation_basis"
      ],
      "type": "object"
    },
    "AuthorityState": {
      "enum": [
        "legacy",
        "successor"
      ],
      "type": "string"
    },
    "AutonomyClass": {
      "enum": [
        "A0",
        "A1",
        "A2",
        "A3",
        "A4",
        "AX"
      ],
      "type": "string"
    },
    "BoundedEvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "comparator_policy": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "component_id": {
          "$ref": "#/$defs/StableId"
        },
        "component_kind": {
          "$ref": "#/$defs/ImplementationComponentKind"
        },
        "evidence": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "global_parity_eligible": {
          "type": "boolean"
        },
        "wave1_package_lock_id": {
          "$ref": "#/$defs/Sha256Digest"
        }
      },
      "required": [
        "component_kind",
        "component_id",
        "evidence",
        "comparator_policy",
        "wave1_package_lock_id",
        "global_parity_eligible"
      ],
      "type": "object"
    },
    "CertificationState": {
      "enum": [
        "uncertified",
        "certified"
      ],
      "type": "string"
    },
    "ContractState": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "$ref": "#/$defs/AuthorityState"
        },
        "certification": {
          "$ref": "#/$defs/CertificationState"
        },
        "declaration": {
          "$ref": "#/$defs/DeclarationState"
        },
        "implementation": {
          "$ref": "#/$defs/ImplementationState"
        },
        "retirement": {
          "$ref": "#/$defs/RetirementState"
        }
      },
      "required": [
        "declaration",
        "implementation",
        "certification",
        "authority",
        "retirement"
      ],
      "type": "object"
    },
    "CoordinationSemantics": {
      "additionalProperties": false,
      "properties": {
        "assignment": {
          "$ref": "#/$defs/StableId"
        },
        "checkpoint_owner": {
          "$ref": "#/$defs/StableId"
        },
        "coverage": {
          "$ref": "#/$defs/StableId"
        },
        "dispatch_cohorts": {
          "items": {
            "$ref": "#/$defs/DispatchCohort"
          },
          "type": "array"
        },
        "phases": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "type": "array"
        },
        "resume": {
          "$ref": "#/$defs/ResumeSemantics"
        },
        "roll_up": {
          "$ref": "#/$defs/StableId"
        },
        "terminal_conditions": {
          "items": {
            "$ref": "#/$defs/TerminalCondition"
          },
          "type": "array"
        }
      },
      "required": [
        "coverage",
        "assignment",
        "dispatch_cohorts",
        "checkpoint_owner",
        "phases",
        "resume",
        "roll_up",
        "terminal_conditions"
      ],
      "type": "object"
    },
    "CredentialBoundary": {
      "additionalProperties": false,
      "properties": {
        "credential_free_scopes": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "type": "array"
        },
        "future_executor": {
          "$ref": "#/$defs/FutureExecutorBoundary"
        }
      },
      "required": [
        "credential_free_scopes",
        "future_executor"
      ],
      "type": "object"
    },
    "DeclarationState": {
      "enum": [
        "declared",
        "absent"
      ],
      "type": "string"
    },
    "DispatchCohort": {
      "additionalProperties": false,
      "properties": {
        "candidate_classes": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "type": "array"
        },
        "cohort_id": {
          "$ref": "#/$defs/StableId"
        },
        "concurrency": {
          "$ref": "#/$defs/DispatchConcurrency"
        },
        "max_concurrency": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "cohort_id",
        "candidate_classes",
        "concurrency"
      ],
      "type": "object"
    },
    "DispatchConcurrency": {
      "enum": [
        "serial",
        "parallel",
        "bounded_parallel"
      ],
      "type": "string"
    },
    "EvidenceAvailability": {
      "enum": [
        "absent",
        "available_validated"
      ],
      "type": "string"
    },
    "EvidenceStatus": {
      "additionalProperties": false,
      "properties": {
        "certification": {
          "$ref": "#/$defs/CertificationState"
        },
        "legacy_artifact_sets": {
          "items": {
            "$ref": "#/$defs/ArtifactSetReference"
          },
          "type": "array"
        },
        "legacy_artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "type": "array"
        },
        "legacy_evidence_satisfies_successor": {
          "type": "boolean"
        },
        "legacy_status": {
          "$ref": "#/$defs/EvidenceAvailability"
        },
        "parity": {
          "$ref": "#/$defs/ParityStatus"
        },
        "successor_implementation": {
          "$ref": "#/$defs/EvidenceAvailability"
        }
      },
      "required": [
        "legacy_status",
        "legacy_artifacts",
        "legacy_artifact_sets",
        "successor_implementation",
        "parity",
        "certification",
        "legacy_evidence_satisfies_successor"
      ],
      "type": "object"
    },
    "ExternalSourceRequirement": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/RepositoryPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "purpose": {
          "$ref": "#/$defs/StableId"
        },
        "required_phase": {
          "$ref": "#/$defs/StableId"
        },
        "requirement_id": {
          "$ref": "#/$defs/StableId"
        },
        "status": {
          "$ref": "#/$defs/ExternalSourceStatus"
        },
        "unavailable_capability_outcome": {
          "$ref": "#/$defs/OutcomeKind"
        },
        "unavailable_worker_verdict": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "requirement_id",
        "purpose",
        "required_phase",
        "status",
        "unavailable_capability_outcome",
        "unavailable_worker_verdict"
      ],
      "type": "object"
    },
    "ExternalSourceStatus": {
      "enum": [
        "unavailable_unproved"
      ],
      "type": "string"
    },
    "FieldType": {
      "enum": [
        "string",
        "boolean",
        "integer_string",
        "artifact_reference",
        "stable_id"
      ],
      "type": "string"
    },
    "FutureExecutorBoundary": {
      "additionalProperties": false,
      "properties": {
        "attendance": {
          "$ref": "#/$defs/StableId"
        },
        "credential_scope": {
          "$ref": "#/$defs/StableId"
        },
        "environment": {
          "$ref": "#/$defs/StableId"
        },
        "review_requirements": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "type": "array"
        }
      },
      "required": [
        "attendance",
        "credential_scope",
        "environment",
        "review_requirements"
      ],
      "type": "object"
    },
    "ImplementationComponentKind": {
      "enum": [
        "capability",
        "worker_role"
      ],
      "type": "string"
    },
    "ImplementationEvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "$ref": "#/$defs/StableId"
        },
        "component_kind": {
          "$ref": "#/$defs/ImplementationComponentKind"
        },
        "evidence": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "subject_manifest": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "validation_basis": {
          "$ref": "#/$defs/ArtifactReference"
        }
      },
      "required": [
        "component_kind",
        "component_id",
        "subject_manifest",
        "evidence",
        "validation_basis"
      ],
      "type": "object"
    },
    "ImplementationState": {
      "enum": [
        "unported",
        "implemented"
      ],
      "type": "string"
    },
    "OutcomeKind": {
      "enum": [
        "succeeded",
        "held",
        "cancelled",
        "policy_violated",
        "failed",
        "recovery_required"
      ],
      "type": "string"
    },
    "ParityStatus": {
      "enum": [
        "unproved",
        "proved"
      ],
      "type": "string"
    },
    "RepositoryPath": {
      "pattern": "^[A-Za-z0-9._/-]{1,1024}$",
      "type": "string"
    },
    "ResumeSemantics": {
      "additionalProperties": false,
      "properties": {
        "completed_assignment_policy": {
          "$ref": "#/$defs/StableId"
        },
        "mismatch_outcome": {
          "$ref": "#/$defs/OutcomeKind"
        },
        "orphan_record_policy": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "completed_assignment_policy",
        "orphan_record_policy",
        "mismatch_outcome"
      ],
      "type": "object"
    },
    "RetirementState": {
      "enum": [
        "not_started",
        "complete"
      ],
      "type": "string"
    },
    "SafetyOverlay": {
      "enum": [
        "credential_free",
        "no_external_mutation",
        "human_gate",
        "path_confined",
        "redacted_diagnostics"
      ],
      "type": "string"
    },
    "SchemaVersion": {
      "enum": [
        "v0"
      ],
      "type": "string"
    },
    "SemanticClaim": {
      "additionalProperties": false,
      "properties": {
        "field_groups": {
          "items": {
            "$ref": "#/$defs/SemanticFieldPath"
          },
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SemanticClaimSource"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/SemanticClaimStatus"
        }
      },
      "required": [
        "field_groups",
        "status",
        "sources"
      ],
      "type": "object"
    },
    "SemanticClaimSource": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "path": {
              "$ref": "#/$defs/RepositoryPath"
            },
            "source_kind": {
              "const": "knowledge_reference",
              "type": "string"
            }
          },
          "required": [
            "source_kind",
            "path"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "path": {
              "$ref": "#/$defs/RepositoryPath"
            },
            "role_id": {
              "$ref": "#/$defs/StableId"
            },
            "source_kind": {
              "const": "worker_knowledge_reference",
              "type": "string"
            }
          },
          "required": [
            "source_kind",
            "role_id",
            "path"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "logical_ids": {
              "items": {
                "$ref": "#/$defs/StableId"
              },
              "type": "array"
            },
            "source_kind": {
              "const": "migration_ledger_rows",
              "type": "string"
            }
          },
          "required": [
            "source_kind",
            "logical_ids"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "artifact_set_id": {
              "$ref": "#/$defs/StableId"
            },
            "source_kind": {
              "const": "legacy_artifact_set",
              "type": "string"
            }
          },
          "required": [
            "source_kind",
            "artifact_set_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "decision_id": {
              "$ref": "#/$defs/StableId"
            },
            "source_kind": {
              "const": "successor_decision",
              "type": "string"
            }
          },
          "required": [
            "source_kind",
            "decision_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "requirement_id": {
              "$ref": "#/$defs/StableId"
            },
            "source_kind": {
              "const": "external_source_requirement",
              "type": "string"
            }
          },
          "required": [
            "source_kind",
            "requirement_id"
          ],
          "type": "object"
        }
      ]
    },
    "SemanticClaimStatus": {
      "enum": [
        "legacy_observed",
        "successor_requirement",
        "unavailable_unproved"
      ],
      "type": "string"
    },
    "SemanticFieldPath": {
      "pattern": "^[a-z][a-z0-9_.*\\[\\]]{0,255}$",
      "type": "string"
    },
    "Sha256Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "TerminalCondition": {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "$ref": "#/$defs/StableId"
        },
        "outcome": {
          "$ref": "#/$defs/OutcomeKind"
        }
      },
      "required": [
        "outcome",
        "condition"
      ],
      "type": "object"
    },
    "TypedField": {
      "additionalProperties": false,
      "properties": {
        "allowed_values": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "type": "array"
        },
        "field_type": {
          "$ref": "#/$defs/FieldType"
        },
        "name": {
          "$ref": "#/$defs/StableId"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "field_type",
        "required"
      ],
      "type": "object"
    }
  },
  "$id": "urn:ls:repository-engineering:schema:bounded:v0:capability-contract-with-bounded-evidence",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "autonomy": {
      "$ref": "#/$defs/AutonomyClass"
    },
    "bounded_evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/BoundedEvidenceReference"
      },
      "type": "array"
    },
    "capability_id": {
      "$ref": "#/$defs/StableId"
    },
    "coordination_semantics": {
      "anyOf": [
        {
          "$ref": "#/$defs/CoordinationSemantics"
        },
        {
          "type": "null"
        }
      ]
    },
    "credential_boundary": {
      "anyOf": [
        {
          "$ref": "#/$defs/CredentialBoundary"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_obligations": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "type": "array"
    },
    "evidence_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceStatus"
        },
        {
          "type": "null"
        }
      ]
    },
    "executor": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactReference"
        },
        {
          "type": "null"
        }
      ]
    },
    "external_source_requirements": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ExternalSourceRequirement"
      },
      "type": "array"
    },
    "human_gates": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "type": "array"
    },
    "implementation_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/ImplementationEvidenceReference"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/TypedField"
      },
      "type": "array"
    },
    "knowledge_references": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "type": "array"
    },
    "legacy_authority_dependencies": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "type": "array"
    },
    "outcomes": {
      "items": {
        "$ref": "#/$defs/OutcomeKind"
      },
      "type": "array"
    },
    "public_description": {
      "type": [
        "string",
        "null"
      ]
    },
    "safety_overlays": {
      "items": {
        "$ref": "#/$defs/SafetyOverlay"
      },
      "type": "array"
    },
    "scenario_references": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "type": "array"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "semantic_claims": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SemanticClaim"
      },
      "type": "array"
    },
    "state": {
      "$ref": "#/$defs/ContractState"
    },
    "touched_paths": {
      "items": {
        "$ref": "#/$defs/RepositoryPath"
      },
      "type": "array"
    },
    "worker_roles": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "capability_id",
    "state",
    "autonomy",
    "safety_overlays",
    "inputs",
    "outcomes",
    "touched_paths",
    "evidence_obligations",
    "human_gates",
    "knowledge_references",
    "worker_roles",
    "scenario_references"
  ],
  "title": "CapabilityContract",
  "type": "object"
}
