{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/RepositoryPath"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Digest"
        }
      },
      "required": [
        "schema_version",
        "path",
        "sha256",
        "media_type"
      ],
      "type": "object"
    },
    "ImplementationComponentKind": {
      "enum": [
        "capability",
        "worker_role"
      ],
      "type": "string"
    },
    "RepositoryPath": {
      "pattern": "^[A-Za-z0-9._/-]{1,1024}$",
      "type": "string"
    },
    "SchemaVersion": {
      "enum": [
        "v0"
      ],
      "type": "string"
    },
    "Sha256Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    }
  },
  "$id": "urn:ls:repository-engineering:schema:bounded:v0:bounded-evidence-reference",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "comparator_policy": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "component_id": {
      "$ref": "#/$defs/StableId"
    },
    "component_kind": {
      "$ref": "#/$defs/ImplementationComponentKind"
    },
    "evidence": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "global_parity_eligible": {
      "type": "boolean"
    },
    "wave1_package_lock_id": {
      "$ref": "#/$defs/Sha256Digest"
    }
  },
  "required": [
    "component_kind",
    "component_id",
    "evidence",
    "comparator_policy",
    "wave1_package_lock_id",
    "global_parity_eligible"
  ],
  "title": "BoundedEvidenceReference",
  "type": "object"
}
